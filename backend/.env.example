# 数据库（PostgreSQL + pgvector）
DATABASE_URL=postgresql+asyncpg://quotepilot:quotepilot123@localhost:5432/quotepilot
DATABASE_URL_SYNC=postgresql+psycopg2://quotepilot:quotepilot123@localhost:5432/quotepilot

# LLM API（可选：不设则用 mock 规则引擎）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding API（DashScope Qwen）
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=5
EMBEDDING_TIMEOUT=60
