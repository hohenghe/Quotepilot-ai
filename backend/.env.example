# 数据库（PostgreSQL + pgvector）
DATABASE_URL=postgresql+asyncpg://quotepilot:quotepilot123@localhost:5432/quotepilot
DATABASE_URL_SYNC=postgresql+psycopg2://quotepilot:quotepilot123@localhost:5432/quotepilot

# LLM API（可选：不设则用 mock 规则引擎）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 视觉识别（商品拍照识别，两阶段：OCR -> 视觉理解）。独立配置，不复用 OPENAI_*。
# AI_OCR_MODEL / AI_VISION_MODEL / AI_VISION_API_KEY / AI_VISION_BASE_URL 必须填写，
# 否则识别接口返回 502。
AI_OCR_MODEL=qwen3.5-ocr
AI_VISION_MODEL=qwen3-vl-235b-a22b-instruct
AI_VISION_API_KEY=
AI_VISION_BASE_URL=
AI_OCR_TIMEOUT=45
AI_VISION_TIMEOUT=60
AI_MAX_IMAGE_DIMENSION=2048

# Embedding API（DashScope Qwen）
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=5
EMBEDDING_TIMEOUT=60

# Cloudflare R2（对象存储）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quotepilot-files
R2_PUBLIC_BASE_URL=https://img.zhermai.com

# Email（Brevo Transactional Email API）
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@zhermai.com
MAIL_FROM_NAME=QuotePilot
FRONTEND_URL=https://zhermai.com

# 微信小程序登录（jscode2session）
WECHAT_APPID=wx4b2ed5a1178b9b43
WECHAT_APP_SECRET=
