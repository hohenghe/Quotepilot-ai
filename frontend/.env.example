# 后端 API 地址（设置后 AI 操作走后端，不设则浏览器内运行）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# LLM API（可选：后端不可用时浏览器内降级使用）
# 支持 OpenAI / DeepSeek / Groq 等任何 OpenAI 兼容 API
NEXT_PUBLIC_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_LLM_BASE_URL=https://api.openai.com/v1
NEXT_PUBLIC_LLM_MODEL=gpt-4o-mini
NEXT_PUBLIC_EMBEDDING_MODEL=text-embedding-3-small

# Supabase 云数据库（跨设备同步，不设则用本地 localStorage）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
