# 数据库（PostgreSQL + pgvector）
DATABASE_URL=postgresql+asyncpg://quotepilot:quotepilot123@localhost:5432/quotepilot
DATABASE_URL_SYNC=postgresql+psycopg2://quotepilot:quotepilot123@localhost:5432/quotepilot

# ── 部署环境 ──
# "production" enables fail-closed checks (JWT secret, no test accounts, strict CORS).
# Any other value (or unset) = development.
ENV=development

# ── JWT ──
# Production MUST set this to a random >=32-byte secret. If ENV=production and
# this is missing/default/too short, the app refuses to start.
JWT_SECRET_KEY=change-me-to-a-random-32+byte-secret

# ── CORS ──
# Comma-separated allowed origins for production. e.g.
# CORS_ORIGINS=https://zhermai.com,https://www.zhermai.com
# Empty in dev → localhost:3000.
CORS_ORIGINS=

# ── Admin 账号（从环境变量读取，源码中无硬编码密码）──
# Production: must set ADMIN_EMAIL + ADMIN_PASSWORD. If unset in prod, admin
# creation is skipped (no default password is ever used).
# Dev: falls back to dev-only creds (admin@localhost / devadmin123).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Dev only: set to "true" to create test accounts. NEVER used in production.
CREATE_TEST_ACCOUNTS=false

# ── /analyze 匿名限流 ──
ANALYZE_ANON_RATE=5
ANALYZE_USER_RATE=30
ANALYZE_MAX_CONCURRENCY=8

# ── 数据库连接池 ──
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# LLM API（可选：不设则用 mock 规则引擎）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 视觉识别（商品拍照识别，两阶段：OCR -> 视觉理解）。独立配置，不复用 OPENAI_*。
# AI_OCR_MODEL / AI_VISION_MODEL / AI_VISION_API_KEY / AI_VISION_BASE_URL 必须填写，
# 否则识别接口返回 502。
AI_OCR_MODEL=qwen3.5-ocr
AI_VISION_MODEL=qwen3-vl-235b-a22b-instruct
AI_VISION_API_KEY=
AI_VISION_BASE_URL=
AI_OCR_TIMEOUT=45
AI_VISION_TIMEOUT=60
AI_MAX_IMAGE_DIMENSION=3072

# Embedding API（DashScope Qwen）
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=5
EMBEDDING_TIMEOUT=60

# Cloudflare R2（对象存储）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quotepilot-files
R2_PUBLIC_BASE_URL=https://img.zhermai.com

# Email（Brevo Transactional Email API）
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@zhermai.com
MAIL_FROM_NAME=QuotePilot
FRONTEND_URL=https://zhermai.com

# 微信小程序登录（jscode2session）
WECHAT_APPID=
WECHAT_APP_SECRET=
